# =====================================================
# Environment Variables - Copy to .env and fill in
# =====================================================

# --- Gemini API (Primary LLM) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Search APIs (choose one or both) ---
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# --- Gmail API (OAuth2) ---
# Generate these from Google Cloud Console
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token

# Your email address (sender)
SENDER_EMAIL=your_email@example.com

# --- Database ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# --- Outreach Configuration ---
MAX_EMAILS_PER_WEEK=10
FOLLOWUP_DAYS=7
# Shortlist cap after scoring (default 6 = fast iteration). Production: 15–25.
TOP_K_PROFESSORS=6
# Crawl/search depth (defaults are small for fast runs). Scale up for real campaigns:
# MAX_CRAWL_URLS=40
# SEARCH_MAX_RESULTS_PER_QUERY=8
# SEMANTIC_SCHOLAR_AUTHORS_PER_KEYWORD=10
# SEMANTIC_SCHOLAR_KEYWORD_COUNT=5
# CRAWL_SNOWBALL=true

# --- Vector DB ---
CHROMADB_PATH=./chroma_db

# =====================================================
# Brain (python main.py brain ...)
# =====================================================
# LLM: any OpenAI-compatible endpoint. LLM_PROVIDER=groq|openai picks base URL, key and models;
# without it, Groq is used when GROQ_API_KEY is set, otherwise OpenAI.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
GROQ_API_KEY=your_groq_api_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=                      # overrides GROQ_API_KEY
# LLM_MODEL_STRONG=openai/gpt-oss-120b   # judging fit, writing emails
# LLM_MODEL_FAST=openai/gpt-oss-20b       # page extraction fallback
# LLM_REASONING_EFFORT=low
# BRAIN_LLM_MAX_CALLS=120           # hard ceiling on paid LLM calls per run

# OpenAlex: works without a key (shared daily budget); a free key gives you your own.
# OPENALEX_API_KEY=

# Limits
# BRAIN_MAX_SEARCH_CALLS=80
# BRAIN_MAX_PAGE_FETCHES=250
# BRAIN_MIN_EMAIL_CONFIDENCE=0.6    # addresses below this are never drafted for
# BRAIN_MAX_PER_ORG=3
# BRAIN_EMBEDDINGS=lexical          # or sentence-transformers
# BRAIN_CACHE_PATH=./.brain_cache.sqlite
