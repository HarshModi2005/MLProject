# =====================================================
# Environment Variables - Copy to .env and fill in
# =====================================================

# --- Gemini API (Primary LLM) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Search APIs (choose one or both) ---
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# --- Gmail API (OAuth2) ---
# Generate these from Google Cloud Console
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token

# Your email address (sender)
SENDER_EMAIL=your_email@example.com

# --- Database ---
SUPABASE_URL=https://pulnbreqirmmpfvumxqu.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# --- Outreach Configuration ---
MAX_EMAILS_PER_WEEK=10
FOLLOWUP_DAYS=7
# Shortlist cap after scoring (default 6 = fast iteration). Production: 15–25.
TOP_K_PROFESSORS=6
# Crawl/search depth (defaults are small for fast runs). Scale up for real campaigns:
# MAX_CRAWL_URLS=40
# SEARCH_MAX_RESULTS_PER_QUERY=8
# SEMANTIC_SCHOLAR_AUTHORS_PER_KEYWORD=10
# SEMANTIC_SCHOLAR_KEYWORD_COUNT=5
# CRAWL_SNOWBALL=true

# --- Vector DB ---
CHROMADB_PATH=./chroma_db

# --- Groq (used by agents today) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Structured JSONL logs (optional) ---
# RUN_LOG_DIR=./run_logs
# ENABLE_STRUCTURED_LOGS=true

# --- Email variants / metadata (optional) ---
# DEFAULT_GENERATE_EMAIL_VARIANTS=false
# ENABLE_EMAIL_DISCOVERY_METADATA=true
